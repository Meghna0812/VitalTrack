# Copy this file to .env and fill in the values. Never commit .env to git.

PORT=4000

# MySQL – where reports and extracted results are stored permanently
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vitaltrack
MYSQL_PASSWORD=vitaltrack
MYSQL_DATABASE=vitaltrack

# Redis – the job queue (BullMQ) lives here
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# DeepSeek – get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Results with model confidence below this go to the review queue
CONFIDENCE_THRESHOLD=0.8

# Google sign-in (optional). Create an OAuth client ID at
# https://console.cloud.google.com/apis/credentials  (type: Web application,
# Authorized JavaScript origin: http://localhost:5173). Leave empty to offer
# only username/password sign-in.
GOOGLE_CLIENT_ID=

# ---- Production / hosting (see GUIDE.md Part 12) ----
# MYSQL_URL=mysql://USER:PASSWORD@HOST:4000/vitaltrack   # overrides the MYSQL_* values above
# MYSQL_SSL=true                                         # cloud databases require TLS
# REDIS_URL=redis://HOST:6379                            # overrides REDIS_HOST/PORT
# RUN_WORKER=true                                        # run the worker inside the API process
# KEEP_UPLOADS=false                                     # delete PDFs after processing (default)
